use com.webforj.bbjship.BBjShipServlet

rem /**
rem  * Answers the BBjShip HTTP API: the version, and the deployment and removal of applications.
rem  *
rem  * @author Hyyan Abo Fakher
rem  * @since 26.03
rem  */
class public WebforjBBjDeploymentServlet
  rem /**
  rem  * Processes one request of the BBjShip HTTP API.
  rem  *
  rem  * @param BBxServletContext context! The servlet request context.
  rem  */
  method public void service(BBxServletContext context!)
    BBjShipServlet.handle(context!.getRequest().getHttpServletRequest(), context!.getResponse().getHttpServletResponse())
  methodend

classend
